<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--
        Views and menus for Merchant Visit model. This allows users to view
        and create visit records from the back‑office. A new menu entry is
        added under the Sales menu.
    -->
    <record id="view_merchant_visit_tree" model="ir.ui.view">
        <field name="name">merchant.visit.tree</field>
        <field name="model">merchant.visit</field>
        <field name="arch" type="xml">
            <list string="Merchant Visits">
                <field name="user_id"/>
                <field name="partner_id"/>
                <field name="visit_datetime"/>
                <field name="notes"/>
            </list>
        </field>
    </record>
    <record id="view_merchant_visit_form" model="ir.ui.view">
        <field name="name">merchant.visit.form</field>
        <field name="model">merchant.visit</field>
        <field name="arch" type="xml">
            <form string="Merchant Visit">
                <sheet>
                    <group>
                        <field name="user_id"/>
                        <field name="partner_id"/>
                        <field name="visit_datetime"/>
                        <field name="notes" placeholder="Add notes here..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Action -->
    <record id="action_merchant_visit" model="ir.actions.act_window">
        <field name="name">Merchant Visits</field>
        <field name="res_model">merchant.visit</field>
        <field name="view_mode">list,form</field>
    </record>
    <!-- Menu -->
    <menuitem id="menu_merchant_visit_root" name="Merchant Visits" parent="base.menu_administration" sequence="200" groups="base.group_user"/>
    <menuitem id="menu_merchant_visit" name="Visits" parent="menu_merchant_visit_root" action="action_merchant_visit" sequence="10" groups="base.group_user"/>
</odoo>