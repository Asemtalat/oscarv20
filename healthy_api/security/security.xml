<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="module_category_healthy_api" model="ir.module.category">
        <field name="name">Healthy API</field>
        <field name="description">Access roles for Healthy mobile API users.</field>
<!--        <field name="sequence">35</field>-->
    </record>
    <record id="res_groups_healthy_api" model="res.groups.privilege">
        <field name="name">Healthy API</field>
        <field name="category_id" ref="module_category_healthy_api"/>
    </record>

    <record id="group_api_delegate" model="res.groups">
        <field name="name">API Delegate</field>
        <field name="privilege_id" ref="healthy_api.res_groups_healthy_api"/>
        <field name="comment">Delegates can manage only their own API sales activity.</field>
    </record>

    <record id="group_api_supervisor" model="res.groups">
        <field name="name">API Supervisor</field>
        <field name="privilege_id" ref="healthy_api.res_groups_healthy_api"/>
        <field name="comment">Supervisors can manage their delegates and assign work.</field>
        <field name="implied_ids" eval="[(4, ref('healthy_api.group_api_delegate'))]"/>
    </record>

    <record id="group_api_warehouse" model="res.groups">
        <field name="name">API Warehouse</field>
        <field name="privilege_id" ref="healthy_api.res_groups_healthy_api"/>
        <field name="comment">Warehouse users can process order preparation workflow.</field>
    </record>

    <record id="group_api_admin" model="res.groups">
        <field name="name">API Admin</field>
        <field name="privilege_id" ref="healthy_api.res_groups_healthy_api"/>
        <field name="comment">API admins can approve users, assign roles, and access all API features.</field>
        <field name="implied_ids" eval="[(4, ref('healthy_api.group_api_delegate')), (4, ref('healthy_api.group_api_supervisor')), (4, ref('healthy_api.group_api_warehouse'))]"/>
    </record>

    <!--<record id="api_signup_request_rule_admin" model="ir.rule">
        <field name="name">API Signup Request Admin Scope</field>
        <field name="model_id" ref="healthy_api.model_api_signup_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('healthy_api.group_api_admin'))]"/>
    </record>-->
</odoo>
