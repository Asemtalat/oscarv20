<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="quant_wiz_warning_view_form" model="ir.ui.view">
            <field name="name">quant.wiz.warning_view_form</field>
            <field name="model">quant.wiz.warning</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <h2>
                                <field name="name" readonly="1"/>
                            </h2>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_produce_warning" type="object" string="Produce All" class="oe_highlight"/>
                    </footer>
                </form>
            </field>
        </record>


    </data>
</odoo>