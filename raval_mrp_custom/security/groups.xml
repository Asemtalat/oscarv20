<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="categ_mrp_qty_approve" model="ir.module.category">
            <field name="name">MRP Qty Approvals</field>
            <field name="sequence" eval="100"/>
        </record>

        <!-- Odoo 20: groups are attached to a privilege, not directly to a category -->
        <record id="privilege_mrp_qty_approve" model="res.groups.privilege">
            <field name="name">MRP Qty Approvals</field>
            <field name="category_id" ref="categ_mrp_qty_approve"/>
        </record>

        <record id="group_1st_mrp_qty" model="res.groups">
            <field name="name">First Approve</field>
            <field name="privilege_id" ref="privilege_mrp_qty_approve"/>
        </record>
        <record id="group_2nd_mrp_qty" model="res.groups">
            <field name="name">Second Approve</field>
            <field name="privilege_id" ref="privilege_mrp_qty_approve"/>
        </record>

    </data>
</odoo>
