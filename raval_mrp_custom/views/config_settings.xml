<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Inherit Form View to Modify it -->
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.mrp</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="mrp.res_config_settings_view_form"/>
            <field name="arch" type="xml">

                <xpath expr="//block[@name='process_operations_setting_container']" position="inside">
                    <setting id="mrp_entry_debit">
                        <field name="mrp_debit_account_id"/>
                    </setting>
                    <setting id="mrp_entry_credit">
                        <field name="mrp_credit_account_id"/>
                    </setting>
                    <setting id="mrp_entry_journal">
                        <field name="mrp_journal_id"/>
                    </setting>
                </xpath>

            </field>
        </record>

    </data>
</odoo>