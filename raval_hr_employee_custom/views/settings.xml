<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit Form View to Modify it -->
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.hr.document.exp</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
            <field name="arch" type="xml">

                <xpath expr="//block[@name='employees_setting_container']" position="after">
                    <block title="Notify Before Expiration" name="notify_expired_documents_before_setting_container">
                        <setting help="Sets the number of days before expiration to send a notification reminder."
                                 title="Sets the number of days before expiration to send a notification reminder.">
                            <field name="notify_expired_documents_before"/> Days
                        </setting>
                    </block>
                </xpath>

            </field>
        </record>


    </data>
</odoo>