<odoo>
    <data>
        <record id="hr_document_form_view" model="ir.ui.view">
            <field name="name">hr.document.form</field>
            <field name="model">hr.document</field>
            <field name="arch" type="xml">
                <form string="Document">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="employee_id" required="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="hr_document_tree_view" model="ir.ui.view">
            <field name="name">hr.document.tree</field>
            <field name="model">hr.document</field>
            <field name="arch" type="xml">
                <list string="Document">
                    <field name="name"/>
                    <field name="employee_id"/>
                </list>
            </field>
        </record>

    </data>
</odoo>