<odoo>
    <record id="inherit_purchase_form" model="ir.ui.view">
        <field name="name">purchase.view.form.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="down_payment"
                        type="object" string="Down Payment" class="btn-primary"
                        invisible="state != 'purchase'"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_downpayment"
                        class="oe_stat_button"
                        icon="fa-bars"
                        type="object"
                        invisible="not downpayment_move_ids">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="downpayment_move_count"/>
                        </span>
                        <span class="o_stat_text">DownPayments</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>