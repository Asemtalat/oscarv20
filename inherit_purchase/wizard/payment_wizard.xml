<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_-wizard_view_form" model="ir.ui.view">
        <field name="name">payment</field>
        <field name="model">payment.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="account_id"/>
                        <field name="description"/>
                        <field name="purchase_id" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="payment_method"/>
                        <field name="percentage_price" widget="percentage"
                               invisible="payment_method != 'percentage'"/>
                        <field name="price" invisible="payment_method != 'fixed_amount'"/>
                        <field name="total_order_amount" string="Total Amount"/>
                    </group>
                </group>
                <footer>
                    <button name="action_create_journal" type="object" string="Create Journal" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>