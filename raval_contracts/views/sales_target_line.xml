<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

       <record id="sales_target_line_view_form" model="ir.ui.view">
           <field name="name">sales.target.line_view_form</field>
           <field name="model">sales.target.line</field>
           <field name="arch" type="xml">
               <form>
                   <sheet>
                       <field name="detailed_sale_orders" force_save="1">
                           <list editable="bottom" create="0" delete="0">
                               <field name="date_from" readonly="1"/>
                               <field name="date_to" readonly="1"/>
                               <field name="total_sale_orders_amount" readonly="1"/>
                               <field name="credit_note_id" readonly="1"/>
                               <button name="action_create_credit_note" invisible="credit_note_id" type="object" string="Create Credit Note"/>
                           </list>
                       </field>
                   </sheet>
               </form>
           </field>
       </record>

    </data>
</odoo>