<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

       <!-- Inherit Form View to Modify it -->
       <record id="sale_order_view_inherit_contract_disc" model="ir.ui.view">
           <field name="name">sale.order.view.inherit.contract.disc</field>
           <field name="model">sale.order</field>
           <field name="inherit_id" ref="sale.view_order_form"/>
           <field name="arch" type="xml">

               <xpath expr="//page[@name='other_information']/group" position="inside">
                    <group name="contract_info" string="Contract">
                        <field name="contract_id"/>
                    </group>
               </xpath>

               <xpath expr="//field[@name='order_line']/list/field[@name='discount']" position="before">
                   <field name="contract_disc" widget="percentage" column_invisible="not parent.contract_id"/>
               </xpath>

           </field>
       </record>

    </data>
</odoo>