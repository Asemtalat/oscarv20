<odoo>
    <data>
        <record id="work_center_form_inherit" model="ir.ui.view">
            <field name="name">work.center.form.inherit</field>
            <field name="model">mrp.workcenter</field>
            <field name="inherit_id" ref="mrp.mrp_workcenter_view"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='capacity']" position="after">
                    <page string="Overhead">
                        <field name="overhead_ids">
                            <list editable="bottom">
                                <field name="expense_id"/>
                                <field name="amount" sum="Total amount"/>
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
        <record id="expense_view_tree" model="ir.ui.view">
            <field name="name">expense.view.tree</field>
            <field name="model">expense.expense</field>
            <field name="arch" type="xml">
                <list string="Expense Tree">
                    <field name="expense"/>
                </list>
            </field>
        </record>
        <record id="expense_view_form" model="ir.ui.view">
            <field name="name">expense.view.form</field>
            <field name="model">expense.expense</field>
            <field name="arch" type="xml">
                <form string="Expenses">
                    <sheet>
                        <group>
                            <field name="expense"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="expense_action" model="ir.actions.act_window">
            <field name="name">Expenses</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">expense.expense</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem id="expense_menu" name="Expense" parent="mrp.menu_mrp_configuration" action="expense_action"
                  sequence="50"/>
    </data>
</odoo>
