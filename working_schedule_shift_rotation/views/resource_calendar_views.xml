<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_resource_calendar_form_shift_rotation" model="ir.ui.view">
        <field name="name">resource.calendar.form.shift.rotation</field>
        <field name="model">resource.calendar</field>
        <field name="inherit_id" ref="resource.resource_calendar_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='calendar_type']" position="after">
                <field name="shift_rotation" widget="boolean_toggle"/>
            </xpath>

            <!-- Odoo 20: two attendance_ids widgets (fixed / variable), both hidden in shift rotation mode -->
            <xpath expr="//field[@name='attendance_ids'][1]" position="attributes">
                <attribute name="invisible">calendar_type != 'fixed' or shift_rotation</attribute>
            </xpath>
            <xpath expr="//field[@name='attendance_ids'][2]" position="attributes">
                <attribute name="invisible">calendar_type != 'variable' or shift_rotation</attribute>
            </xpath>

            <xpath expr="//sheet" position="inside">
                <group string="Shift Rotation" invisible="not shift_rotation">

                    <!-- ── Week 1 ─────────────────────────────────────────── -->
                    <separator string="Week 1"/>
                    <group>
                        <field name="rotation_week_1_from"/>
                        <field name="rotation_week_1_to"/>
                        <field name="rotation_week_1_period"/>

                    </group>
                    <group>

                        <field name="rotation_week_1_default_hour_from" widget="float_time"/>
                        <field name="rotation_week_1_default_hour_to" widget="float_time"/>
                    </group>
                    <group>
                        <field name="rotation_week_1_total_hours" widget="float_time" readonly="1"/>
                    </group>
                    <field name="rotation_week_1_attendance_line_ids" nolabel="1">
                        <list editable="bottom" default_order="date_from">
                            <field name="name" column_invisible="True" force_save="1"/>
                            <field name="is_shift_rotation_line" column_invisible="True" force_save="1"/>
                            <field name="shift_rotation_week" column_invisible="True" force_save="1"/>
                            <field name="date_from" force_save="1"/>
                            <field name="date_to" column_invisible="True" force_save="1"/>
                            <field name="dayofweek" force_save="1"/>
                            <field name="day_period" force_save="1"/>
                            <field name="hour_from" widget="float_time"/>
                            <field name="hour_to" widget="float_time"/>
                        </list>
                    </field>

                    <!-- ── Week 2 ─────────────────────────────────────────── -->
                    <separator string="Week 2"/>
                    <group>
                        <field name="rotation_week_2_from"/>
                        <field name="rotation_week_2_to"/>
                        <field name="rotation_week_2_period"/>

                    </group>
                    <group>

                        <field name="rotation_week_2_default_hour_from" widget="float_time"/>
                        <field name="rotation_week_2_default_hour_to" widget="float_time"/>
                    </group>
                    <group>
                        <field name="rotation_week_2_total_hours" widget="float_time" readonly="1"/>
                    </group>
                    <field name="rotation_week_2_attendance_line_ids" nolabel="1">
                        <list editable="bottom" default_order="date_from">
                            <field name="name" column_invisible="True" force_save="1"/>
                            <field name="is_shift_rotation_line" column_invisible="True" force_save="1"/>
                            <field name="shift_rotation_week" column_invisible="True" force_save="1"/>
                            <field name="date_from" force_save="1"/>
                            <field name="date_to" column_invisible="True" force_save="1"/>
                            <field name="dayofweek" force_save="1"/>
                            <field name="day_period" force_save="1"/>
                            <field name="hour_from" widget="float_time"/>
                            <field name="hour_to" widget="float_time"/>
                        </list>
                    </field>

                    <!-- ── Week 3 ─────────────────────────────────────────── -->
                    <separator string="Week 3"/>
                    <group>
                        <field name="rotation_week_3_from"/>
                        <field name="rotation_week_3_to"/>
                        <field name="rotation_week_3_period"/>

                    </group>
                    <group>
                        <field name="rotation_week_3_default_hour_from" widget="float_time"/>
                        <field name="rotation_week_3_default_hour_to" widget="float_time"/>
                    </group>
                    <group>
                        <field name="rotation_week_3_total_hours" widget="float_time" readonly="1"/>
                    </group>
                    <field name="rotation_week_3_attendance_line_ids" nolabel="1">
                        <list editable="bottom" default_order="date_from">
                            <field name="name" column_invisible="True" force_save="1"/>
                            <field name="is_shift_rotation_line" column_invisible="True" force_save="1"/>
                            <field name="shift_rotation_week" column_invisible="True" force_save="1"/>
                            <field name="date_from" force_save="1"/>
                            <field name="date_to" column_invisible="True" force_save="1"/>
                            <field name="dayofweek" force_save="1"/>
                            <field name="day_period" force_save="1"/>
                            <field name="hour_from" widget="float_time"/>
                            <field name="hour_to" widget="float_time"/>
                        </list>
                    </field>

                    <!-- ── Week 4 ─────────────────────────────────────────── -->
                    <separator string="Week 4"/>
                    <group>
                        <field name="rotation_week_4_from"/>
                        <field name="rotation_week_4_to"/>
                        <field name="rotation_week_4_period"/>
                    </group>
                    <group>

                        <field name="rotation_week_4_default_hour_from" widget="float_time"/>
                        <field name="rotation_week_4_default_hour_to" widget="float_time"/>
                    </group>
                    <group>
                        <field name="rotation_week_4_total_hours" widget="float_time" readonly="1"/>
                    </group>
                    <field name="rotation_week_4_attendance_line_ids" nolabel="1">
                        <list editable="bottom" default_order="date_from">
                            <field name="name" column_invisible="True" force_save="1"/>
                            <field name="is_shift_rotation_line" column_invisible="True" force_save="1"/>
                            <field name="shift_rotation_week" column_invisible="True" force_save="1"/>
                            <field name="date_from" force_save="1"/>
                            <field name="date_to" column_invisible="True" force_save="1"/>
                            <field name="dayofweek" force_save="1"/>
                            <field name="day_period" force_save="1"/>
                            <field name="hour_from" widget="float_time"/>
                            <field name="hour_to" widget="float_time"/>
                        </list>
                    </field>

                </group>
            </xpath>
        </field>
    </record>
</odoo>
