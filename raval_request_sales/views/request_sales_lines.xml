<odoo>
    <data>

        <record id="request_sales_lines_search_view" model="ir.ui.view">
            <field name="name">request.sales.lines.search.view</field>
            <field name="model">request.sales.lines</field>
            <field name="arch" type="xml">
                <search>
                    <field name="categ_id" invisible="1"/>
                    <group>
                        <filter name="categ_group_by" string="Category" context="{'group_by':'categ_id'}"/>
                    </group>
                </search>
            </field>
        </record>


        <record id="request_sales_lines_view_tree" model="ir.ui.view">
            <field name="name">request.sales.lines_view_tree</field>
            <field name="model">request.sales.lines</field>
            <field name="arch" type="xml">
                <list create="0" edit="0">
                    <header>
                        <button name="action_open_lines" type="object" string="Select Lines" class="btn-primary"/>
                    </header>
                    <field name="request_id"/>
                    <field name="user_id"/>
                    <field name="scheduled_date"/>
                    <field name="product_id"/>
                    <field name="quantity"/>
                    <field name="done_qty"/>
                    <field name="uom_id"/>
                    <field name="available_qty"/>
                    <field name="diff_qty"/>
                    <field name="purchase_id" column_invisible="1"/>
                    <button name="action_open_purchase" type="object" string="Purchase" icon="fa-link" invisible="not purchase_id"/>
                </list>
            </field>
        </record>

        <record id="request_sales_lines_action" model="ir.actions.act_window">
            <field name="name">Request Sales Lines</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">request.sales.lines</field>
            <field name="view_mode">list</field>
        </record>

        <menuitem id="request_sales_line_menu" parent="request_sales_root" action="request_sales_lines_action" sequence="2"/>
    </data>
</odoo>
