<odoo>
    <data>
        <record id="view_move_form_inherited" model="ir.ui.view">
            <field name="name">stock.production.lot.inherited.form</field>
            <field name="model">stock.lot</field>
            <field name="inherit_id" ref="stock.view_production_lot_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[2]" position="replace">
                    <div class="oe_title">
                        <label for="display_complete_name"/>
                        <h1>
                            <field name="display_complete_name" placeholder="e.g. LOT/0001/20121"/>
                        </h1>
                    </div>
                </xpath>
            </field>
        </record>

        <record id="view_production_lot_view_tree_inherited" model="ir.ui.view">
            <field name="name">stock.production.lot.list.inherited</field>
            <field name="model">stock.lot</field>
            <field name="inherit_id" ref="stock.view_production_lot_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="display_complete_name"/>
                </xpath>
                <xpath expr="//field[@name='name']" position="attributes">
                    <attribute name="column_invisible">True</attribute>
                </xpath>

            </field>
        </record>

        <record id="search_product_lot_filter_inherited" model="ir.ui.view">
            <field name="name">stock.production.lot.search.inherited</field>
            <field name="model">stock.lot</field>
            <field name="inherit_id" ref="stock.search_product_lot_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="display_complete_name" string="Lot/Serial Number - Barcode"
                           filter_domain="['|', '|', ('display_complete_name', 'ilike', self),('name', 'ilike', self),('ref', 'ilike', self)]"/>

                </xpath>
            </field>
        </record>

    </data>
</odoo>