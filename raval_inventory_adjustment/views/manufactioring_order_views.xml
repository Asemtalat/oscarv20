        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook/page[@name='operations']/field[@name='workorder_ids']/list/field[@name='duration']" position="attributes">
