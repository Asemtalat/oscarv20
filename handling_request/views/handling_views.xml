<odoo>
    <record id="view_handling_tree" model="ir.ui.view">
        <field name="name">request.handling.tree</field>
        <field name="model">request.handling</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="user_id"/>
                <field name="scheduled_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_handling_form" model="ir.ui.view">
        <field name="name">request.handling.form</field>
        <field name="model">request.handling</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit"
                            type="object"
                            string="Submit"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_approve"
                            type="object"
                            string="Approve"
                            class="btn-success"
                            invisible="state != 'submitted'"/>

                    <button name="action_reject"
                            type="object"
                            string="Reject"
                            class="btn-danger"
                            invisible="state != 'submitted'"/>
                    <button name="action_create_internal_transfer" type="object" string="Create Internal Transfer"
                            class="btn-primary" invisible="state != 'approved' or picking_id"/>

                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_internal_transfer"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-pencil-square-o"
                                string="Internal Transfer" invisible="not picking_id">
                        </button>
                        <button name="action_view_adjustment"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-pencil-square-o"
                                string="Handling Adjustment">
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <field name="user_id"/>
                        <field name="scheduled_date"/>
                        <field name="location_id"/>
                    </group>
                    <notebook>
                        <page string="Request Lines">
                            <field name="handling_line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_handling_requests" model="ir.actions.act_window">
        <field name="name">Handling Requests</field>
        <field name="res_model">request.handling</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- Inherit Form View to Modify it -->
    <record id="request_sales_view_form_inherit" model="ir.ui.view">
        <field name="name">request.sales.handling</field>
        <field name="model">request.sales</field>
        <field name="inherit_id" ref="raval_request_sales.request_sales_view_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
<!--<<<<<<< HEAD-->
<!--                <button name="action_view_handling_request"-->
<!--=======-->
                <button name="action_create_handling_request"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-pencil-square-o"
                        string="Handling Request" invisible="not handle_id">
                </button>
            </div>

            <xpath expr="//button[@name='action_create_po_for_lines']" position="after">
                <button name="action_create_handling_request"
                        type="object"
                        string="Create Handling Request"
                        class="btn-secondary" invisible="handle_id"/>
            </xpath>

        </field>
    </record>
</odoo>
