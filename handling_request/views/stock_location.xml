<odoo>
    <record id="view_location_form_inherit" model="ir.ui.view">
        <field name="name">stock.location.handling</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='replenish_location']" position="after">
                <field name="is_main_location"/>
            </xpath>

        </field>
    </record>
    <record id="view_picking_form_inherit" model="ir.ui.view">
        <field name="name">stock.picking.handling</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='owner_id']" position="after">
                <field name="handling_id" invisible="not handling_id"/>
            </xpath>
        </field>
    </record>
</odoo>
