<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_access_group_assign_form" model="ir.ui.view">
        <field name="name">access.group.assign.form</field>
        <field name="model">access.group.assign</field>
        <field name="arch" type="xml">
            <form string="Mass Assignment">
                <group>
                    <field name="user_ids" domain="[('share', '=', False)]" widget="many2many_tags"
                           options="{'no_create': True}"/>
                    <field name="operation" widget="radio"/>
                </group>
                <group>
                    <field name="group_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                    <field name="role_ids" widget="many2many_tags"
                           options="{'no_create_edit': True}"/>
                    <field name="profile_ids" widget="many2many_tags"
                           options="{'no_create_edit': True}"/>
                </group>
                <group invisible="not role_ids or operation == 'remove'">
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Apply"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_access_group_assign" model="ir.actions.act_window">
        <field name="name">Mass Assignment</field>
        <field name="res_model">access.group.assign</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_access_group_assign" name="Mass Assignment"
              parent="menu_access_management_root"
              action="action_access_group_assign"
              groups="access_management_ai.group_access_manager" sequence="25"/>

    <record id="action_access_group_assign_users" model="ir.actions.act_window">
        <field name="name">Mass Assignment</field>
        <field name="res_model">access.group.assign</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_users"/>
        <field name="binding_view_types">list,form</field>
        <field name="group_ids" eval="[Command.link(ref('access_management_ai.group_access_manager'))]"/>
    </record>
</odoo>
