<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_access_transfer_form" model="ir.ui.view">
        <field name="name">access.management.transfer.form</field>
        <field name="model">access.management.transfer</field>
        <field name="arch" type="xml">
            <form string="Import / Export Profiles">
                <group>
                    <group string="Export">
                        <field name="profile_ids" widget="many2many_tags"
                               options="{'no_create': True}"
                               placeholder="Leave empty to export all profiles"/>
                        <field name="export_file" filename="export_filename" readonly="1"
                               invisible="not export_file"/>
                        <field name="export_filename" invisible="1"/>
                    </group>
                    <group string="Import">
                        <field name="import_file" filename="import_filename"/>
                        <field name="import_filename" invisible="1"/>
                    </group>
                </group>
                <footer>
                    <button name="action_export" type="object" string="Export"
                            class="btn-primary"/>
                    <button name="action_import" type="object" string="Import"
                            class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_access_transfer" model="ir.actions.act_window">
        <field name="name">Import / Export</field>
        <field name="res_model">access.management.transfer</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- <menuitem id="menu_access_transfer" name="Import / Export"
              parent="access_management_ai.menu_access_management_config_categ"
              action="action_access_transfer"
              groups="access_management_ai.group_access_manager" sequence="40"/> -->
</odoo>
