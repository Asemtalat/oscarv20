<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_access_login_log_list" model="ir.ui.view">
        <field name="name">access.login.log.list</field>
        <field name="model">access.login.log</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false" default_order="login_date desc">
                <field name="login_date"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="login"/>
                <field name="event" decoration-success="event == 'login'"
                       decoration-danger="event == 'failed'" decoration-muted="event == 'logout'"
                       widget="badge"/>
                <field name="ip" optional="show"/>
                <field name="browser" optional="show"/>
                <field name="platform" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="session_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_access_login_log_graph" model="ir.ui.view">
        <field name="name">access.login.log.graph</field>
        <field name="model">access.login.log</field>
        <field name="arch" type="xml">
            <graph string="Login Activity" type="bar">
                <field name="login_date" interval="day" type="row"/>
                <field name="event" type="col"/>
                <field name="id" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_access_login_log_pivot" model="ir.ui.view">
        <field name="name">access.login.log.pivot</field>
        <field name="model">access.login.log</field>
        <field name="arch" type="xml">
            <pivot string="Login Activity">
                <field name="login_date" type="row" interval="day"/>
                <field name="event" type="col"/>
                <field name="id" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_access_login_log_form" model="ir.ui.view">
        <field name="name">access.login.log.form</field>
        <field name="model">access.login.log</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="event" widget="badge"/></h1>
                    </div>
                    <group>
                        <group string="Event">
                            <field name="login_date"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="login"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="session_id"/>
                        </group>
                        <group string="Client">
                            <field name="ip"/>
                            <field name="browser"/>
                            <field name="platform"/>
                            <field name="country"/>
                            <field name="city"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_access_login_log_search" model="ir.ui.view">
        <field name="name">access.login.log.search</field>
        <field name="model">access.login.log</field>
        <field name="arch" type="xml">
            <search string="Search Login Audit">
                <field name="user_id"/>
                <field name="login"/>
                <field name="ip"/>
                <field name="browser"/>
                <field name="platform"/>
                <field name="country"/>
                <field name="company_id" groups="base.group_multi_company"/>

                <filter name="logins" string="Logins" domain="[('event', '=', 'login')]"/>
                <filter name="logouts" string="Logouts" domain="[('event', '=', 'logout')]"/>
                <filter name="failed" string="Failed" domain="[('event', '=', 'failed')]"/>

                <separator/>
                <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                <filter name="group_event" string="Event" context="{'group_by': 'event'}"/>
                <filter name="group_date" string="Date" context="{'group_by': 'login_date:day'}"/>
                <filter name="group_browser" string="Browser" context="{'group_by': 'browser'}"/>
                <filter name="group_platform" string="Platform" context="{'group_by': 'platform'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company"/>
            </search>
        </field>
    </record>

    <record id="action_access_login_log" model="ir.actions.act_window">
        <field name="name">Login Audit</field>
        <field name="res_model">access.login.log</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="search_view_id" ref="view_access_login_log_search"/>
    </record>

    <menuitem id="menu_access_login_log" name="Login Audit"
              parent="access_management_ai.menu_access_management_reporting_categ"
              action="action_access_login_log"
              groups="access_management_ai.group_access_user" sequence="30"/>
</odoo>
