<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_access_request_form" model="ir.ui.view">
        <field name="name">access.request.form</field>
        <field name="model">access.request</field>
        <field name="arch" type="xml">
            <form string="Access Request">
                <header>
                    <button name="action_submit" string="Submit" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight" groups="access_management_ai.group_access_manager" invisible="state != 'submitted'"/>
                    <button name="action_reject" string="Reject" type="object" class="btn-danger" groups="access_management_ai.group_access_manager" invisible="state != 'submitted'"/>
                    <button name="action_revoke" string="Revoke Access" type="object" class="btn-warning" groups="access_management_ai.group_access_manager" invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Approved" bg_color="text-bg-success" invisible="state != 'approved'"/>
                    <widget name="web_ribbon" title="Rejected" bg_color="text-bg-danger" invisible="state != 'rejected'"/>
                    <widget name="web_ribbon" title="Expired" bg_color="text-bg-warning" invisible="state != 'expired'"/>
                    <widget name="web_ribbon" title="Revoked" bg_color="text-bg-danger" invisible="state != 'revoked'"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id" domain="[('share', '=', False)]" readonly="state != 'draft'" widget="many2one_avatar_user"/>
                            <field name="role_id" invisible="profile_id != False" readonly="state != 'draft'"/>
                            <field name="profile_id" invisible="role_id != False" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="date_from" readonly="state != 'draft'"/>
                            <field name="date_to" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group>
                        <field name="request_reason" readonly="state != 'draft'"/>
                        <field name="approver_id" readonly="1" invisible="state not in ('approved', 'rejected')" widget="many2one_avatar_user"/>
                        <field name="rejection_reason" readonly="1" invisible="state != 'rejected'"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_access_request_tree" model="ir.ui.view">
        <field name="name">access.request.list</field>
        <field name="model">access.request</field>
        <field name="arch" type="xml">
            <list string="Access Requests">
                <field name="name"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="role_id" optional="show"/>
                <field name="profile_id" optional="hide"/>
                <field name="date_to" optional="show"/>
                <field name="approver_id" optional="hide" widget="many2one_avatar_user"/>
                <field name="state" widget="badge" decoration-info="state == 'submitted'" decoration-success="state == 'approved'" decoration-danger="state in ('rejected', 'revoked')" decoration-warning="state == 'expired'"/>
            </list>
        </field>
    </record>
    <record id="view_access_request_kanban" model="ir.ui.view">
        <field name="name">access.request.kanban</field>
        <field name="model">access.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="name"/>
                <field name="user_id"/>
                <field name="role_id"/>
                <field name="profile_id"/>
                <field name="state"/>
                <field name="date_to"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <div class="o_dropdown_kanban dropdown">
                                    <a class="dropdown-toggle o-no-caret btn" role="button" data-bs-toggle="dropdown" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                        <span class="fa fa-ellipsis-v"/>
                                    </a>
                                    <div class="dropdown-menu" role="menu">
                                        <t t-if="widget.editable"><a role="menuitem" type="edit" class="dropdown-item">Edit</a></t>
                                        <t t-if="widget.deletable"><a role="menuitem" type="delete" class="dropdown-item">Delete</a></t>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>
                                    <strong>User: </strong> <field name="user_id"/>
                                </div>
                                <div t-if="record.role_id.raw_value">
                                    <strong>Role: </strong> <field name="role_id"/>
                                </div>
                                <div t-if="record.profile_id.raw_value">
                                    <strong>Profile: </strong> <field name="profile_id"/>
                                </div>
                                <div t-if="record.date_to.raw_value">
                                    <strong>Expiry: </strong> <field name="date_to"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom mt-2">
                                <div class="oe_kanban_bottom_left">
                                    <field name="state" widget="badge" decoration-info="state == 'submitted'" decoration-success="state == 'approved'" decoration-danger="state in ('rejected', 'revoked')" decoration-warning="state == 'expired'"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_access_request_reject_form" model="ir.ui.view">
        <field name="name">access.request.reject.form</field>
        <field name="model">access.request.reject</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="reason" placeholder="Reason for rejection..."/>
                </group>
                <footer>
                    <button name="action_reject" type="object" string="Reject" class="btn-danger"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_access_request_search" model="ir.ui.view">
        <field name="name">access.request.search</field>
        <field name="model">access.request</field>
        <field name="arch" type="xml">
            <search string="Search Access Requests">
                <field name="name"/>
                <field name="user_id"/>
                <field name="role_id"/>
                <field name="profile_id"/>
                <field name="approver_id"/>
                <field name="state"/>
                <field name="request_reason"/>

                <filter string="My Requests" name="my_requests" domain="[('user_id', '=', uid)]"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="To Approve" name="to_approve" domain="[('state', '=', 'submitted')]"/>
                <separator/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <filter string="Expired" name="expired" domain="[('state', '=', 'expired')]"/>
                <filter string="Revoked" name="revoked" domain="[('state', '=', 'revoked')]"/>

                <separator/>
                <filter string="Status" name="group_status" context="{'group_by':'state'}"/>
                <filter string="User" name="group_user" context="{'group_by':'user_id'}"/>
                <filter string="Role" name="group_role" context="{'group_by':'role_id'}"/>
                <filter string="Profile" name="group_profile" context="{'group_by':'profile_id'}"/>
                <filter string="Approver" name="group_approver" context="{'group_by':'approver_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_access_request_pivot" model="ir.ui.view">
        <field name="name">access.request.pivot</field>
        <field name="model">access.request</field>
        <field name="arch" type="xml">
            <pivot string="Access Requests Analysis" sample="1">
                <field name="user_id" type="row"/>
                <field name="state" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_access_request_graph" model="ir.ui.view">
        <field name="name">access.request.graph</field>
        <field name="model">access.request</field>
        <field name="arch" type="xml">
            <graph string="Access Requests Analysis" type="bar" sample="1">
                <field name="state"/>
            </graph>
        </field>
    </record>

    <record id="view_access_request_calendar" model="ir.ui.view">
        <field name="name">access.request.calendar</field>
        <field name="model">access.request</field>
        <field name="arch" type="xml">
            <calendar string="Access Requests" date_start="create_date" color="state" mode="month" event_open_popup="true">
                <field name="name"/>
                <field name="user_id" avatar_field="avatar_128"/>
                <field name="state" filters="1" invisible="1"/>
            </calendar>
        </field>
    </record>

    <record id="action_access_request" model="ir.actions.act_window">
        <field name="name">Access Requests</field>
        <field name="res_model">access.request</field>
        <field name="view_mode">list,kanban,form,calendar,pivot,graph</field>
        <field name="search_view_id" ref="view_access_request_search"/>
        <field name="context">{'search_default_to_approve': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new access request.
            </p>
        </field>
    </record>

    <!-- Bulk Approval Server Action -->
    <record id="action_bulk_approve_requests" model="ir.actions.server">
        <field name="name">Bulk Approve Requests</field>
        <field name="model_id" ref="model_access_request"/>
        <field name="binding_model_id" ref="model_access_request"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            for record in records:
                if record.state == 'submitted':
                    record.action_approve()
        </field>
    </record>

    <menuitem id="menu_access_request"
              name="Access Requests"
              parent="access_management_ai.menu_access_management_requests_categ"
              action="action_access_request"
              sequence="50"/>
</odoo>
