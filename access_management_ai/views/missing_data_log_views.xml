<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_missing_data_log_tree" model="ir.ui.view">
        <field name="name">access.missing.data.log.tree</field>
        <field name="model">access.missing.data.log</field>
        <field name="arch" type="xml">
            <list string="Missing Data Logs" default_order="create_date desc">
                <field name="import_date"/>
                <field name="name"/>
                <field name="model_name"/>
                <field name="field_name"/>
                <field name="missing_type" widget="badge" decoration-warning="missing_type == 'model'" decoration-danger="missing_type == 'field'"/>
                <field name="message"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_missing_data_log_form" model="ir.ui.view">
        <field name="name">access.missing.data.log.form</field>
        <field name="model">access.missing.data.log</field>
        <field name="arch" type="xml">
            <form string="Missing Data Log">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="missing_type"/>
                            <field name="import_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="model_name"/>
                            <field name="field_name"/>
                        </group>
                    </group>
                    <group>
                        <field name="message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_missing_data_log_search" model="ir.ui.view">
        <field name="name">access.missing.data.log.search</field>
        <field name="model">access.missing.data.log</field>
        <field name="arch" type="xml">
            <search string="Search Missing Data Logs">
                <field name="name"/>
                <field name="model_name"/>
                <field name="field_name"/>
                <field name="missing_type"/>
                <field name="message"/>
                <field name="company_id" groups="base.group_multi_company"/>

                <filter name="type_model" string="Missing Model" domain="[('missing_type', '=', 'model')]"/>
                <filter name="type_field" string="Missing Field" domain="[('missing_type', '=', 'field')]"/>
                <filter name="type_element" string="Missing Element" domain="[('missing_type', '=', 'element')]"/>

                <separator/>
                <filter string="Type" name="type" context="{'group_by':'missing_type'}"/>
                <filter string="Model" name="model" context="{'group_by':'model_name'}"/>
                <filter string="Field" name="field" context="{'group_by':'field_name'}"/>
                <filter string="Import Date" name="group_date" context="{'group_by':'import_date:day'}"/>
                <filter string="Company" name="group_company" context="{'group_by':'company_id'}"
                        groups="base.group_multi_company"/>
            </search>
        </field>
    </record>

    <record id="view_missing_data_log_pivot" model="ir.ui.view">
        <field name="name">access.missing.data.log.pivot</field>
        <field name="model">access.missing.data.log</field>
        <field name="arch" type="xml">
            <pivot string="Missing Data Logs Analysis" sample="1">
                <field name="import_date" type="row" interval="day"/>
                <field name="missing_type" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_missing_data_log_graph" model="ir.ui.view">
        <field name="name">access.missing.data.log.graph</field>
        <field name="model">access.missing.data.log</field>
        <field name="arch" type="xml">
            <graph string="Missing Data Logs Analysis" sample="1">
                <field name="import_date" interval="day"/>
                <field name="missing_type"/>
            </graph>
        </field>
    </record>

    <record id="action_missing_data_log" model="ir.actions.act_window">
        <field name="name">Missing Data Logs</field>
        <field name="res_model">access.missing.data.log</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_missing_data_log_search"/>
    </record>

    <menuitem id="menu_missing_data_log"
              name="Missing Data Log"
              parent="access_management_ai.menu_access_management_reporting_categ"
              action="action_missing_data_log"
              sequence="40"/>
</odoo>
