<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_access_management_tag_tree" model="ir.ui.view">
        <field name="name">access.management.tag.tree</field>
        <field name="model">access.management.tag</field>
        <field name="arch" type="xml">
            <list string="Tags" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="view_access_management_tag_search" model="ir.ui.view">
        <field name="name">access.management.tag.search</field>
        <field name="model">access.management.tag</field>
        <field name="arch" type="xml">
            <search string="Search Tags">
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="action_access_management_tag" model="ir.actions.act_window">
        <field name="name">Profile Tags</field>
        <field name="res_model">access.management.tag</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_access_management_tag_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new tag
            </p>
            <p>
                Tags are used to categorize and filter your access profiles.
            </p>
        </field>
    </record>

    <menuitem id="menu_access_management_tag" name="Tags"
              parent="access_management_ai.menu_access_management_config_categ"
              action="action_access_management_tag"
              sequence="30"/>
</odoo>
