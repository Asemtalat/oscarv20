<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- class="'…'" is an OWL expression, so hasclass() cannot match it. -->
    <t t-name="web.SearchBarMenu" t-inherit="web.SearchBarMenu" t-inherit-mode="extension">
        <xpath expr="//DropdownItem[@onSelected.bind='this.onAddCustomFilterClick']" position="replace">
            <DropdownItem t-if="!this.hideCustomFilter"
                          class="'o_menu_item o_add_custom_filter'"
                          onSelected.bind="this.onAddCustomFilterClick">Custom Filter...</DropdownItem>
        </xpath>
    </t>
</templates>
